#!/usr/bin/make -f
include /usr/share/dpkg/architecture.mk

# As the Dockerfile builds: the query planner stability guarantee of the bundled SQLite (the
# repository's .cargo/config.toml sets it too), and a jemalloc that runs on 4, 16 and 64 KiB
# page kernels on arm64.
export LIBSQLITE3_FLAGS = -DSQLITE_ENABLE_QPSG
ifeq ($(DEB_HOST_ARCH),arm64)
export JEMALLOC_SYS_WITH_LG_PAGE = 16
endif

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	cargo build --release --locked -p rradius-server

# The test suite runs in CI; it needs ports and takes long.
override_dh_auto_test:

override_dh_auto_install:
	install -D -m 0755 target/release/rradiusd debian/rradius/usr/bin/rradiusd
	install -d debian/rradius/usr/share/rradius
	cp -a share/. debian/rradius/usr/share/rradius/
	install -d debian/rradius/usr/share/doc/rradius
	cp -a docs/manual.zh-TW debian/rradius/usr/share/doc/rradius/manual
	install -m 0644 LICENSE debian/rradius/usr/share/doc/rradius/LICENSE
	install -m 0644 docs/usage.md debian/rradius/usr/share/doc/rradius/usage.md
	cp -a rradius-server/examples debian/rradius/usr/share/doc/rradius/examples
	install -m 0644 packages/common/README.packages debian/rradius/usr/share/doc/rradius/README.packages
	install -D -m 0644 packages/common/rradius.logrotate debian/rradius/etc/logrotate.d/rradius
	install -d -m 0750 debian/rradius/var/lib/rradius debian/rradius/var/log/rradius
	install -d debian/rradius/etc/rradius debian/rradius/etc/rradius/conf.d

# The documentation stays readable where the manual and the service file point to it.
override_dh_compress:
	dh_compress -Xusr/share/doc/rradius

# The package does not enable the service: the operator does, once the configuration exists (the
# unit does not start without it either). Without --no-start a service that is enabled and running
# is restarted by an upgrade; with it, the upgrade stopped the service and left it stopped.
override_dh_installsystemd:
	dh_installsystemd --no-enable

# Rust binaries carry no DWARF the tool can compress, and the debug info is not packaged.
override_dh_dwz:

override_dh_auto_clean:
	rm -rf target
