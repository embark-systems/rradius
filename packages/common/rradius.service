[Unit]
Description=rradius RADIUS and TACACS+ server
Documentation=file:///usr/share/doc/rradius/manual/README.md
After=network-online.target
Wants=network-online.target
# Without a configuration there is nothing to run: see /usr/share/doc/rradius/README.packages.
ConditionPathExists=/etc/rradius/rradius.toml

[Service]
Type=simple
User=rradius
Group=rradius
ExecStart=/usr/bin/rradius-server serve
# A node whose database cannot be recovered exits with status 1 and a restart recovers it.
Restart=on-failure
RestartSec=2
# Stopping takes about 15 seconds on a cluster node (see usage.md, section 1).
TimeoutStopSec=60
# SIGHUP reloads the configuration and reopens the accounting log.
ExecReload=/bin/kill -HUP $MAINPID
# Port 49 (TACACS+) is below 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
LimitNOFILE=65536
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/rradius /var/log/rradius

[Install]
WantedBy=multi-user.target
