# A Samba AD DC for checking the netlogon handler, with eapol_test to log in through rradius.
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
        samba samba-ad-dc samba-ad-provision winbind krb5-config eapoltest openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY dc-start.sh /usr/local/bin/dc-start.sh
CMD ["/usr/local/bin/dc-start.sh"]
